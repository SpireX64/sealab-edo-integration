{
  "name": "saby-tms-client",
  "version": "1.0.0",
  "description": "Клиент Saby TMS для работы с электронными перевозочными документами (ЭПД)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "test:e2e": "vitest run"
  },
  "dependencies": {
    "json-rpc-2.0": "^1.7.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "typescript": "^5",
    "vitest": "^3.0.5"
  }
}